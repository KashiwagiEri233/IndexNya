# ============================================================
# Index-学习智能助手 — 环境配置
# 讯飞各功能凭证独立，请在控制台分别获取
# ============================================================

# ===== 1. LLM (讯飞星火 X2，OpenAI 兼容协议) =====
# 控制台获取 APIPassword: https://console.xfyun.cn/
# X2 专属路径 /x2/chat/completions；model 字段仍填 "spark-x"
LLM_API_KEY=your-spark-api-password-here
LLM_BASE_URL=https://spark-api-open.xf-yun.com/x2/
LLM_MODEL=spark-x

# 备选 provider（OpenAI 兼容均可切换）：
# LLM_API_KEY=sk-xxx
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o

# ===== 2. 讯飞数字人视频生成 API =====
# https://www.xfyun.cn/doc/spark/videoGenerate.html
# 控制台 → 数字人视频生成 → 获取 AppID / APIKey / APISecret
VIDEO_APP_ID=your-video-app-id
VIDEO_API_KEY=your-video-api-key
VIDEO_API_SECRET=your-video-api-secret
VIDEO_HOST=vms.cn-huadong-1.xf-yun.com

# ===== 3. 讯飞智能 PPT v2 API =====
# https://www.xfyun.cn/doc/spark/PPTv2.html
# 控制台 → 智能PPT → 获取 AppID / APISecret（PPT 只需 secret，无 apiKey）
PPT_APP_ID=your-ppt-app-id
PPT_API_SECRET=your-ppt-api-secret
PPT_HOST=zwapi.xfyun.cn

# ===== 4. 讯飞文生图 tti API =====
# https://www.xfyun.cn/doc/spark/ImageGeneration.html
# 控制台 → 图像生成 → 获取 AppID / APIKey / APISecret
IMAGE_APP_ID=your-image-app-id
IMAGE_API_KEY=your-image-api-key
IMAGE_API_SECRET=your-image-api-secret
IMAGE_HOST=spark-api.cn-huabei-1.xf-yun.com
IMAGE_PATH=/v2.1/tti
IMAGE_WIDTH=1024
IMAGE_HEIGHT=1024

# ===== 5. 讯飞图片理解 API（WebSocket） =====
# https://www.xfyun.cn/doc/spark/ImageUnderstanding.html
# 与文生图 tti 同组凭证（控制台同一服务，复用上面的 IMAGE_APP_ID/KEY/SECRET）
IMAGE_UNDERSTANDING_PATH=/v2.1/image
IMAGE_UNDERSTANDING_DOMAIN=imagev3

# ===== 应用配置 =====
APP_NAME=Index-学习智能助手
DATABASE_URL=sqlite:///./learning_agent.db
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
LOG_LEVEL=INFO
