# ============================================================
# Index 学习岛 — 环境配置
# 讯飞各功能凭证独立，请在控制台分别获取
# ============================================================

# ===== 1. LLM（OpenAI 兼容协议，可选） =====
# 不再内置默认模型。推荐直接在前端模型选择器中添加模型；
# 如果要使用服务端固定模型，请显式填写下面三项。
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# 示例（按需取消注释并修改）：
# LLM_API_KEY=sk-xxx
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o

# ===== 2. 讯飞文生图 tti API =====

# https://www.xfyun.cn/doc/spark/ImageGeneration.html
# 控制台 → 图像生成 → 获取 AppID / APIKey / APISecret
IMAGE_APP_ID=your-image-app-id
IMAGE_API_KEY=your-image-api-key
IMAGE_API_SECRET=your-image-api-secret
IMAGE_HOST=spark-api.cn-huabei-1.xf-yun.com
IMAGE_PATH=/v2.1/tti
IMAGE_WIDTH=1024
IMAGE_HEIGHT=1024

# ===== 5. 讯飞图片理解 API（WebSocket） =====
# https://www.xfyun.cn/doc/spark/ImageUnderstanding.html
# 与文生图 tti 同组凭证（控制台同一服务，复用上面的 IMAGE_APP_ID/KEY/SECRET）
IMAGE_UNDERSTANDING_PATH=/v2.1/image
IMAGE_UNDERSTANDING_DOMAIN=imagev3

# ===== 应用配置 =====
APP_NAME=Index 学习岛
DATABASE_URL=sqlite:///./learning_agent.db
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
LOG_LEVEL=INFO
