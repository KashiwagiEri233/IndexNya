# ===== 1. LLM（OpenAI 兼容协议，可选） =====
# 不再内置默认模型。推荐直接在前端模型选择器中添加模型；
# 如果要使用服务端固定模型，请显式填写下面三项。
# 图片理解（上传图片提问）复用该文本模型的多模态能力，无需单独配置。
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# 示例（按需取消注释并修改）：
# LLM_API_KEY=sk-xxx
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o

# ===== 应用配置 =====
APP_NAME=Index 学习岛
DATABASE_URL=sqlite:///./learning_agent.db
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
LOG_LEVEL=INFO