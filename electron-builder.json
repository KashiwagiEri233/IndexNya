{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.indexnya.app",
  "productName": "Index 学习岛",
  "copyright": "Copyright © 2026 IndexNya",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**",
    "dist-electron/**",
    "src/runtime/skills/**",
    "public/**",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "src/runtime/skills",
      "to": "skills",
      "filter": [
        "**/*"
      ]
    }
  ],
  "mac": {
    "target": [
      "dmg",
      "zip"
    ],
    "category": "public.app-category.education",
    "hardenedRuntime": false,
    "gatekeeperAssess": false
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Index 学习岛"
  },
  "linux": {
    "target": [
      "AppImage",
      "deb"
    ],
    "category": "Education"
  }
}
